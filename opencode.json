{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "laravel-boost": {
      "type": "local",
      "enabled": true,
      "command": ["php", "artisan", "boost:mcp"]
    },
    "21st": {
      "type": "remote",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "{env:TWENTYFIRST_API_KEY}"
      }
    }
  }
}
